{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anifrz",
  "version": "0.1.0",
  "identifier": "com.anifrz.app",
  "build": {
    "beforeBuildCommand": "cd src/ui/frontend && npm run build",
    "beforeDevCommand": "cd src/ui/frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "src/ui/frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "anifrz",
        "width": 1080,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
